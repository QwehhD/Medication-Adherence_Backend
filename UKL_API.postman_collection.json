{
  "info": {
    "name": "Medication Adherence API Suite",
    "description": "Combined collection for Medication Adherence API and Patient Registration Sync Tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get All Doctors (for registration)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/doctors"
          }
        },
        {
          "name": "Register Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@example.com\",\n  \"username\": \"dr_john\",\n  \"password\": \"password123\",\n  \"role\": \"DOCTOR\"\n}"
            }
          }
        },
        {
          "name": "Register Patient (with assigned doctor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.com\",\n  \"username\": \"patient_jane\",\n  \"password\": \"password123\",\n  \"role\": \"PATIENT\",\n  \"doctorId\": \"DOCTOR_ID_FROM_DOCTORS_LIST_HERE\"\n}"
            }
          }
        },
        {
          "name": "Register Patient (without assigned doctor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient2@example.com\",\n  \"username\": \"patient_alex\",\n  \"password\": \"password123\",\n  \"role\": \"PATIENT\"\n}"
            }
          }
        },
        {
          "name": "Verify Email (click link from email)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/verify-email?token=TOKEN_FROM_EMAIL_HERE"
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token_doctor', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token_patient', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Doctor - Patients",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/patients"
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/patients/:id",
            "variable": [{ "key": "id", "value": "PATIENT_PROFILE_ID_HERE" }]
          }
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/patients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newpatient@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Jane Doe\",\n  \"age\": 28,\n  \"main_disease\": \"Hypertension\",\n  \"whatsapp_number\": \"081234567892\"\n}"
            }
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/patients/:id",
            "variable": [{ "key": "id", "value": "PATIENT_PROFILE_ID_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Doe Updated\",\n  \"age\": 29,\n  \"main_disease\": \"Diabetes\",\n  \"whatsapp_number\": \"081234567893\"\n}"
            }
          }
        },
        {
          "name": "Delete Patient (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/patients/:id",
            "variable": [{ "key": "id", "value": "PATIENT_PROFILE_ID_HERE" }]
          }
        }
      ]
    },
    {
      "name": "Doctor - Medications",
      "item": [
        {
          "name": "Get All Medications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/medications"
          }
        },
        {
          "name": "Get Medication by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/medications/:id",
            "variable": [{ "key": "id", "value": "MEDICATION_ID_HERE" }]
          }
        },
        {
          "name": "Create Medication",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/medications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metformin\",\n  \"slot_number\": 1,\n  \"stock\": 100\n}"
            }
          }
        },
        {
          "name": "Update Medication",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/medications/:id",
            "variable": [{ "key": "id", "value": "MEDICATION_ID_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metformin 500mg\",\n  \"stock\": 150\n}"
            }
          }
        },
        {
          "name": "Delete Medication",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/medications/:id",
            "variable": [{ "key": "id", "value": "MEDICATION_ID_HERE" }]
          }
        }
      ]
    },
    {
      "name": "Doctor - Schedules",
      "item": [
        {
          "name": "Get All Schedules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/schedules"
          }
        },
        {
          "name": "Get Schedule by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/schedules/:id",
            "variable": [{ "key": "id", "value": "SCHEDULE_ID_HERE" }]
          }
        },
        {
          "name": "Create Schedule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/schedules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"PATIENT_USER_ID_HERE\",\n  \"medicine_id\": \"MEDICINE_ID_HERE\",\n  \"dose\": \"1 tablet\",\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2026-06-30\",\n  \"times\": [\"08:00\", \"12:00\", \"18:00\"]\n}"
            }
          }
        },
        {
          "name": "Update Schedule",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/schedules/:id",
            "variable": [{ "key": "id", "value": "SCHEDULE_ID_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dose\": \"2 tablets\",\n  \"end_date\": \"2026-07-31\",\n  \"times\": [\"08:00\"]\n}"
            }
          }
        },
        {
          "name": "Delete Schedule",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/schedules/:id",
            "variable": [{ "key": "id", "value": "SCHEDULE_ID_HERE" }]
          }
        }
      ]
    },
    {
      "name": "Doctor - Verifications",
      "item": [
        {
          "name": "Get Waiting Verifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/doctor/verifications"
          }
        },
        {
          "name": "Approve Consumption",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_doctor}}" }],
            "url": "{{base_url}}/doctor/consumptions/:id/approve",
            "variable": [{ "key": "id", "value": "CONSUMPTION_ID_HERE" }]
          }
        },
        {
          "name": "Reject Consumption",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_doctor}}" }
            ],
            "url": "{{base_url}}/doctor/consumptions/:id/reject",
            "variable": [{ "key": "id", "value": "CONSUMPTION_ID_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejection_reason\": \"Proof image is unclear\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Patient",
      "item": [
        {
          "name": "Get Today's Schedules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_patient}}" }],
            "url": "{{base_url}}/patient/schedules/today"
          }
        },
        {
          "name": "Upload Consumption Proof",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_patient}}" }],
            "url": "{{base_url}}/patient/consumptions",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "proof_image", "type": "file", "src": "", "description": "Image file (jpg/png, max 5MB)" },
                { "key": "schedule_id", "type": "text", "value": "SCHEDULE_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Get Consumption History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_patient}}" }],
            "url": "{{base_url}}/patient/history"
          }
        }
      ]
    },
    {
      "name": "Patient Registration - Sync Test",
      "item": [
        {
          "name": "1. Get Doctors List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/doctors",
              "host": ["{{base_url}}"],
              "path": ["auth", "doctors"]
            }
          },
          "response": []
        },
        {
          "name": "2. Doctor Path - Create Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.doctor@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Jane Doe\",\n  \"age\": 28,\n  \"main_disease\": \"Hypertension\",\n  \"whatsapp_number\": \"081234567892\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/patients",
              "host": ["{{base_url}}"],
              "path": ["patients"]
            }
          },
          "response": []
        },
        {
          "name": "3. Patient Self-Register Path - Without Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.self1@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"John Smith\",\n  \"age\": 35,\n  \"main_disease\": \"Diabetes\",\n  \"whatsapp_number\": \"081987654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register-patient",
              "host": ["{{base_url}}"],
              "path": ["auth", "register-patient"]
            }
          },
          "response": []
        },
        {
          "name": "4. Patient Self-Register Path - With Doctor Assignment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.self2@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Maria Garcia\",\n  \"age\": 42,\n  \"main_disease\": \"Asthma\",\n  \"whatsapp_number\": \"081555666777\",\n  \"doctorId\": \"{{doctor_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register-patient",
              "host": ["{{base_url}}"],
              "path": ["auth", "register-patient"]
            }
          },
          "response": []
        },
        {
          "name": "5. Verify Patient Email (from email link)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/verify-email?token={{verification_token}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-email"],
              "query": [
                {
                  "key": "token",
                  "value": "{{verification_token}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "6. Doctor-Created Patient Login (no verification needed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.doctor@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "7. Self-Registered Patient Login (after verification)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.self2@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "8. Get Patient Profile (authenticated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "9. Get All Patients (doctor only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/patients",
              "host": ["{{base_url}}"],
              "path": ["patients"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "token_doctor", "value": "", "type": "string" },
    { "key": "token_patient", "value": "", "type": "string" },
    { "key": "doctor_token", "value": "", "type": "string" },
    { "key": "doctor_id", "value": "", "type": "string" },
    { "key": "patient_token", "value": "", "type": "string" },
    { "key": "verification_token", "value": "", "type": "string" }
  ]
}